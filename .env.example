# --- Supabase (REQUIRES USER ACTION — see PROJECT_STATUS.md) ---------------
# Create a project at https://supabase.com, then run the migration in
# supabase/migrations/ against it: `supabase db push --db-url <SESSION_POOLER_URL>`.
# Use the session pooler connection string (Project Settings → Database → Connect
# → "Session pooler"), not the direct db.<ref>.supabase.co host — the direct host
# is IPv6-only and unreachable from networks without IPv6 egress.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never exposed to the client. Used for
# scheduled sync jobs (Vercel Cron) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (REQUIRES USER ACTION — see PROJECT_STATUS.md) -----------
# Create an OAuth 2.0 Client ID in Google Cloud Console with the Calendar and
# Gmail APIs enabled. It needs TWO redirect URIs registered:
#   1. https://<your-project-ref>.supabase.co/auth/v1/callback  (Supabase's own
#      callback — required for Supabase Auth's Google provider to work at all)
#   2. ${NEXT_PUBLIC_SITE_URL}/auth/callback  (this app's callback, after Supabase
#      finishes the exchange)
# Then paste the same Client ID/Secret into Supabase → Authentication → Providers
# → Google and enable it — sign-in will fail with "provider is not enabled" until
# this step is done, even with these env vars set correctly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron / sync (Phase 9+) -------------------------------------------------
# Shared secret checked by app/api/cron routes to reject unauthenticated
# invocations from anywhere but Vercel Cron.
CRON_SECRET=
