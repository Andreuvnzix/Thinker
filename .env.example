# --- Supabase (REQUIRES USER ACTION — see PROJECT_STATUS.md) ---------------
# Create a project at https://supabase.com, then run the migration in
# supabase/migrations/ against it (or `supabase db push` with the CLI).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never exposed to the client. Used for
# scheduled sync jobs (Vercel Cron) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (REQUIRES USER ACTION — see PROJECT_STATUS.md) -----------
# Create an OAuth 2.0 Client ID in Google Cloud Console with the Calendar and
# Gmail APIs enabled, and add ${NEXT_PUBLIC_SITE_URL}/auth/callback as an
# authorized redirect URI (also register it as a Supabase Auth Google provider
# redirect URL).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron / sync (Phase 9+) -------------------------------------------------
# Shared secret checked by app/api/cron routes to reject unauthenticated
# invocations from anywhere but Vercel Cron.
CRON_SECRET=
